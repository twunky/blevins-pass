<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EventRegistration.Api</RootNamespace>
    <!-- Lets developers keep the Stripe test key outside the repo: dotnet user-secrets set "Stripe:SecretKey" "sk_test_..." -->
    <UserSecretsId>blevinspass-api-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Stripe.net" Version="48.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EventRegistration.Tests" />
  </ItemGroup>

</Project>
